# Copier ce fichier en .env.local (non versionné) et compléter selon les besoins.
# Sur Vercel : Project Settings → Environment Variables.

# --- Projet Firebase (par défaut : production "buddyetude") -------------------------------
# À renseigner pour brancher un projet de test (staging) séparé.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# --- Connexion Microsoft ---------------------------------------------------------------------
# À activer seulement après avoir configuré le fournisseur Microsoft dans Firebase Authentication.
# VITE_ENABLE_MICROSOFT=true

# --- App Check (clé de site Fraud Defense / reCAPTCHA Enterprise) ---------------------------
# Console Firebase → App Check → enregistrer l'app web avec Fraud Defense.
# VITE_APPCHECK_SITE_KEY=
# Ancien reCAPTCHA v3 (obsolète) à la place : VITE_APPCHECK_PROVIDER=v3

# --- Notifications push (Firebase Cloud Messaging) ------------------------------------------
# Console Firebase → Paramètres du projet → Cloud Messaging → Certificats Web Push → Générer.
# VITE_FCM_VAPID_KEY=

# --- Suivi des erreurs Sentry --------------------------------------------------------------
# sentry.io → nouveau projet React → DSN.
# VITE_SENTRY_DSN=

# --- Développement local sur émulateurs ----------------------------------------------------
# VITE_USE_EMULATORS=true
