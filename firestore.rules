rules_version = '2';

// Règles Firestore de BuddyEtude.
// Déploiement : firebase deploy --only firestore:rules
// Tests       : npm run test:rules (émulateur local)
//
// Modèle : tout est identifié par uid (jamais par email, qui n'est plus exposé).
// Une paire d'étudiants a un identifiant fixe : "<uid1>_<uid2>" (uids triés).
// Les uids Firebase ne contiennent pas "_", le découpage est donc sûr.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ Fonctions
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(me()));
    }

    // Compte banni par la modération : plus aucune création possible.
    // bans/<uid> est tenu par le serveur (Cloud Function onBanChanged) : supprimer puis recréer
    // son profil ne lève donc plus le bannissement (faille corrigée le 27/11/2026).
    function isBannedUid(uid) { return exists(/databases/$(database)/documents/bans/$(uid)); }
    function notBanned() {
      let profile = /databases/$(database)/documents/users/$(me());
      return !isBannedUid(me())
        && (!exists(profile) || get(profile).data.get('banned', false) != true);
    }

    // Mesures de modération sur un profil (moderation/<uid>), écrites par la modération seule.
    // Comme bans/, elles survivent à la suppression puis recréation du profil.
    //  - bio_locked / photo_locked : présentation / photo retirées, pas de nouvelle pour l'instant
    //  - hidden : profil masqué de la recherche (ex. nom inapproprié), jusqu'à « Rendre visible »
    //  - restricted : profil hors de la recherche, plus de nouvelles demandes (les binômes restent)
    function modOf(uid) {
      let path = /databases/$(database)/documents/moderation/$(uid);
      return exists(path) ? get(path).data : {};
    }
    function isRestrictedUid(uid) { return modOf(uid).get('restricted', false) == true; }
    function respectsModeration(uid, d) {
      let m = modOf(uid);
      return (m.get('bio_locked', false) != true || d.get('bio', '') == '')
        && (m.get('photo_locked', false) != true || d.get('photo_url', '') == '')
        && ((m.get('restricted', false) != true && m.get('hidden', false) != true) || d.get('profile_visible', false) != true);
    }

    // Texte facultatif d'au plus max caractères
    function shortText(d, field, max) {
      return !(field in d) || d[field] == null || (d[field] is string && d[field].size() <= max);
    }

    // Lien de fichier hébergé chez nous (Firebase Storage), ou émulateur local en test.
    // Empêche les liens « javascript: » (exécution de code au clic) ou vers des sites tiers.
    function isStorageUrl(url) {
      return url is string && url.size() <= 2000
        && (url.matches('https://firebasestorage[.]googleapis[.]com/.*')
            || url.matches('http://127[.]0[.]0[.]1:9199/.*'));
    }

    // Photo de profil : Firebase Storage, photo du compte Google, ou aucune
    function isPhotoUrl(url) {
      return url == null || url == ''
        || isStorageUrl(url)
        || (url is string && url.size() <= 2000 && url.matches('https://lh[0-9][.]googleusercontent[.]com/.*'));
    }

    // Noms réservés : pas de faux « BuddyEtude », « Modération », « Modérateur » ni « Administrateur »
    function isAllowedName(name) {
      return name is string && name.size() <= 60
        && !name.lower().matches('.*(buddy ?[eé]tude|mod[eé]ration|mod[eé]rat(eur|rice)|administrat(eur|rice)).*');
    }

    // Profil : tailles maximales (un profil géant ralentissait la recherche de tout le monde)
    function validProfile(d) {
      return (!('display_name' in d) || isAllowedName(d.display_name))
        && shortText(d, 'full_name', 60)
        && shortText(d, 'bio', 1000)
        && shortText(d, 'city', 80)
        && shortText(d, 'school', 120)
        && shortText(d, 'level', 40)
        && shortText(d, 'study_style', 40)
        && (!('subjects' in d) || (d.subjects is list && d.subjects.size() <= 30))
        && (!('availability' in d) || (d.availability is list && d.availability.size() <= 20))
        && (!('goals' in d) || (d.goals is list && d.goals.size() <= 20));
    }

    function canWrite() { return signedIn() && notBanned(); }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function pairOf(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    // Liste [uidA, uidB] triée, dont l'id de paire est pairId
    function isPairList(list, pairId) {
      return list is list && list.size() == 2 && list[0] < list[1]
        && pairId == list[0] + '_' + list[1];
    }

    // Les deux étudiants sont binômes : la demande (id = paire) est acceptée
    function areBuddies(pairId) {
      let req = /databases/$(database)/documents/requests/$(pairId);
      return exists(req) && get(req).data.status == 'accepted';
    }

    // other a bloqué me (document blocks/<bloqueur>_<bloqué>)
    function blockedBy(other) {
      return exists(/databases/$(database)/documents/blocks/$(other + '_' + me()));
    }

    // ---------------------------------------------------------------- Profils
    match /users/{userId} {
      // Son propre profil, un profil visible, ou la modération
      allow read: if signedIn()
        && (me() == userId || resource.data.profile_visible == true || isAdmin());

      // On n'écrit que son propre profil ; l'email n'y est plus stocké (vie privée)
      // et on ne peut pas modifier soi-même le bannissement
      // banned (modération) et verified_* (badge « étudiant vérifié », posé par le serveur)
      // ne sont jamais écrits par l'utilisateur lui-même
      allow create: if signedIn() && me() == userId
        && !isBannedUid(me())
        && !('email' in request.resource.data)
        && !request.resource.data.keys().hasAny(['banned', 'verified_domain', 'verified_at'])
        && validProfile(request.resource.data)
        && isPhotoUrl(request.resource.data.get('photo_url', null))
        && respectsModeration(me(), request.resource.data);
      allow update: if signedIn() && me() == userId
        && !('email' in request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'verified_domain', 'verified_at'])
        && validProfile(request.resource.data)
        && respectsModeration(me(), request.resource.data)
        // Photo vérifiée seulement quand elle change (les anciennes restent modifiables)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photo_url'])
            || isPhotoUrl(request.resource.data.get('photo_url', null)));
      allow delete: if signedIn() && me() == userId;

      // Modération : bannir, masquer, retirer la présentation ou la photo d'un profil
      allow update: if isAdmin() && onlyChanges(['banned', 'profile_visible', 'bio', 'photo_url']);

      // Données privées (préférences de notification, âge…) : propriétaire seulement
      // (sauf les documents tenus par le serveur : quota de demandes, code de vérification
      // étudiant, anti-spam des e-mails, que l'utilisateur ne doit ni lire ni modifier)
      match /private/{docId} {
        allow read, write: if signedIn() && me() == userId
          && !(docId in ['quota', 'verification', 'notif_state']);
      }
    }

    // ------------------------------------------------- Demandes de binôme
    // id = paire de uids : une seule demande par paire (plus de demandes croisées)
    match /requests/{pairId} {
      allow read: if signedIn()
        && (me() == resource.data.from_uid || me() == resource.data.to_uid);

      allow create: if canWrite()
        && request.resource.data.from_uid == me()
        && request.resource.data.to_uid != me()
        && pairId == pairOf(me(), request.resource.data.to_uid)
        && isPairList(request.resource.data.participants, pairId)
        && request.resource.data.status == 'pending'
        && !blockedBy(request.resource.data.to_uid)
        // Compte restreint par la modération : plus de nouvelles demandes
        && !isRestrictedUid(me())
        // Le nom d'expéditeur est celui du profil (sinon : faux « Équipe BuddyEtude » dans les e-mails)
        && request.resource.data.get('from_name', '') == get(/databases/$(database)/documents/users/$(me())).data.get('display_name', '')
        && shortText(request.resource.data, 'to_name', 60)
        && shortText(request.resource.data, 'message', 1000)
        && shortText(request.resource.data, 'subject', 80);

      // Seul le destinataire accepte, et seulement le statut
      allow update: if signedIn()
        && resource.data.to_uid == me()
        && onlyChanges(['status'])
        && request.resource.data.status == 'accepted';

      // Refus, annulation, retrait du binôme ou blocage : l'un ou l'autre
      allow delete: if signedIn()
        && (me() == resource.data.from_uid || me() == resource.data.to_uid);
    }

    // ---------------------------------------------------------------- Blocages
    // id = "<bloqueur>_<bloqué>"
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blocker == me();
      allow create: if signedIn()
        && request.resource.data.blocker == me()
        && blockId == me() + '_' + request.resource.data.blocked
        && request.resource.data.blocked != me();
      allow delete: if signedIn() && resource.data.blocker == me();
    }

    // ---------------------------------------------------------------- Messages
    match /messages/{messageId} {
      allow read: if signedIn()
        && (me() in resource.data.participants
            || me() in resource.data.get('unreadBy', []));

      // Uniquement entre binômes (demande acceptée)
      allow create: if canWrite()
        && request.resource.data.senderUid == me()
        && me() in request.resource.data.participants
        && isPairList(request.resource.data.participants, request.resource.data.chatId)
        && areBuddies(request.resource.data.chatId)
        && request.resource.data.get('unreadBy', []).toSet()
             .difference(request.resource.data.participants.toSet().difference([me()].toSet()))
             .size() == 0
        && request.resource.data.get('text', '').size() <= 4000
        // Pièce jointe : uniquement un fichier de notre stockage (pas de lien « javascript: »)
        && (request.resource.data.get('fileUrl', null) == null || isStorageUrl(request.resource.data.fileUrl))
        && shortText(request.resource.data, 'fileName', 200)
        && shortText(request.resource.data, 'fileType', 100);

      // L'auteur modifie son texte
      allow update: if signedIn()
        && resource.data.senderUid == me()
        && onlyChanges(['text', 'isEdited'])
        && request.resource.data.text.size() <= 4000;

      // Le destinataire marque comme lu : il ne peut que se retirer de unreadBy
      allow update: if signedIn()
        && me() in resource.data.participants
        && onlyChanges(['unreadBy'])
        && request.resource.data.unreadBy == resource.data.unreadBy.removeAll([me()]);

      allow delete: if signedIn() && resource.data.senderUid == me();
    }

    // -------------------------------------------------------- Sessions d'étude
    match /sessions/{sessionId} {
      allow read: if signedIn() && me() in resource.data.participants;

      allow create: if canWrite()
        && request.resource.data.organizer_uid == me()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && me() in request.resource.data.participants
        && areBuddies(pairOf(request.resource.data.participants[0], request.resource.data.participants[1]))
        && request.resource.data.status == 'planned'
        && shortText(request.resource.data, 'title', 120)
        && shortText(request.resource.data, 'notes', 2000)
        && shortText(request.resource.data, 'organizer_name', 60)
        && shortText(request.resource.data, 'buddy_name', 60)
        && shortText(request.resource.data, 'meeting_url', 500)
        && (request.resource.data.get('meeting_url', '') == '' || request.resource.data.meeting_url.matches('https://.*'));

      // Terminer ou annuler : l'un ou l'autre participant, statut uniquement
      allow update: if signedIn()
        && me() in resource.data.participants
        && onlyChanges(['status'])
        && request.resource.data.status in ['completed', 'cancelled'];

      allow delete: if false;
    }

    // ---------------------------------------------------- Avis après session
    // id = "<sessionId>_<uid de l'auteur>" : un avis par personne et par session
    match /feedback/{feedbackId} {
      allow create: if canWrite()
        && request.resource.data.from_uid == me()
        && feedbackId == request.resource.data.sessionId + '_' + me()
        && me() in get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.participants
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && shortText(request.resource.data, 'comment', 2000);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------- Tableaux blancs
    // id = paire de uids (binôme) ou "grp-<id du groupe>" (groupe de révision).
    // Les traits sont des documents de la sous-collection strokes ; "page" = numéro de page.
    match /whiteboards/{boardId} {
      function isGroupBoard() { return boardId.matches('grp-[A-Za-z0-9]+'); }
      function boardGroup() {
        return get(/databases/$(database)/documents/groups/$(boardId.replace('^grp-', '')));
      }
      function isBoardMember() {
        return signedIn() && (
          (isGroupBoard() && me() in boardGroup().data.members)
          || (!isGroupBoard() && me() in boardId.split('_'))
        );
      }
      // Binôme : la demande doit être acceptée ; groupe : être membre suffit
      function boardActive() { return isGroupBoard() || areBuddies(boardId); }
      function validBoardData(d) {
        return d.get('pageCount', 1) is int && d.get('pageCount', 1) >= 1 && d.get('pageCount', 1) <= 200
          && d.get('backgrounds', {}) is map;
      }

      // resource == null : tableau pas encore créé (le premier onSnapshot doit pouvoir écouter)
      allow read: if isBoardMember();

      allow create: if isBoardMember() && notBanned() && boardActive()
        && validBoardData(request.resource.data)
        && (isGroupBoard() || isPairList(request.resource.data.participants, boardId));
      allow update: if isBoardMember() && notBanned()
        && validBoardData(request.resource.data)
        && request.resource.data.get('participants', null) == resource.data.get('participants', null);
      allow delete: if false;

      match /strokes/{strokeId} {
        allow read: if isBoardMember();
        allow create: if isBoardMember() && notBanned()
          && request.resource.data.uid == me()
          && boardActive()
          && request.resource.data.get('points', []).size() <= 6000
          && request.resource.data.get('page', 0) is int
          && request.resource.data.get('page', 0) >= 0 && request.resource.data.get('page', 0) < 200;
        // Défaire (ses propres traits) et "Effacer la page" (tous les membres)
        allow delete: if isBoardMember();
        allow update: if false;
      }
    }

    // ------------------------------------------------------- Groupes de révision
    // 2 à 6 membres. Le créateur (owner) ajoute ses binômes un par un, retire des membres,
    // renomme ou supprime le groupe ; un membre peut quitter le groupe.
    match /groups/{groupId} {
      function addedMembers() { return request.resource.data.members.removeAll(resource.data.members); }
      function validGroup(d) {
        return d.name is string && d.name.size() >= 1 && d.name.size() <= 60
          && d.get('subject', '') is string && d.get('subject', '').size() <= 60
          && d.members is list && d.members.size() <= 6
          && d.get('member_names', {}) is map;
      }

      allow read: if signedIn() && me() in resource.data.members;

      allow create: if canWrite()
        && request.resource.data.owner_uid == me()
        && request.resource.data.members == [me()]
        && validGroup(request.resource.data);

      // Créateur : un seul nouveau membre à la fois, qui doit être son binôme
      allow update: if canWrite()
        && resource.data.owner_uid == me()
        && request.resource.data.owner_uid == me()
        && me() in request.resource.data.members
        && validGroup(request.resource.data)
        && onlyChanges(['name', 'subject', 'members', 'member_names'])
        && (addedMembers().size() == 0
            || (addedMembers().size() == 1
                && areBuddies(pairOf(me(), addedMembers()[0]))
                && !blockedBy(addedMembers()[0])));

      // Membre : quitter le groupe (se retirer soi-même, rien d'autre)
      allow update: if signedIn()
        && me() in resource.data.members
        && resource.data.owner_uid != me()
        && request.resource.data.members == resource.data.members.removeAll([me()])
        && onlyChanges(['members', 'member_names']);

      allow delete: if signedIn() && resource.data.owner_uid == me();

      // Discussion du groupe
      match /messages/{messageId} {
        function isGroupMember() {
          return signedIn() && me() in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        }
        allow read: if isGroupMember();
        allow create: if canWrite() && isGroupMember()
          && request.resource.data.senderUid == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 4000;
        allow delete: if signedIn() && resource.data.senderUid == me();
        allow update: if false;
      }
    }

    // ------------------------------------------------------------ Signalements
    match /reports/{reportId} {
      allow create: if canWrite()
        && request.resource.data.reporter_uid == me()
        && request.resource.data.reported_uid != me()
        && request.resource.data.status == 'pending'
        && shortText(request.resource.data, 'reason', 200)
        && shortText(request.resource.data, 'details', 2000);
      // Modération
      allow read: if isAdmin();
      allow update: if isAdmin() && onlyChanges(['status', 'handledAt', 'handledBy']);
      allow delete: if false;
    }

    // ---------------------------------------------- Mesures de modération par profil
    // L'étudiant lit les siennes (bandeau d'explication) ; seule la modération les écrit
    match /moderation/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------- Modération
    // Les comptes administrateurs se créent à la main dans la console (admins/<uid>)
    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false;
    }

    // -------------------------------------------- Compteur public de l'accueil
    // Maintenu par la Cloud Function onProfileWrite (functions/) : lecture seule ici
    match /stats/public {
      allow read: if true;
      allow write: if false;
    }
    // Aperçu anonymisé de profils (niveau, matières, badge vérifié ; aucun nom ni photo),
    // maintenu par la Cloud Function refreshPublicPreview : lecture seule ici
    match /stats/preview {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------- Tout le reste : fermé par défaut
    // (dont "mail" : file d'envoi d'e-mails, écrite uniquement par les Cloud Functions)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
