rules_version = '2';

// Règles Firestore de BuddyEtude.
// Déploiement : firebase deploy --only firestore:rules
// Tests       : npm run test:rules (émulateur local)
//
// Modèle : tout est identifié par uid (jamais par email, qui n'est plus exposé).
// Une paire d'étudiants a un identifiant fixe : "<uid1>_<uid2>" (uids triés).
// Les uids Firebase ne contiennent pas "_", le découpage est donc sûr.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ Fonctions
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(me()));
    }

    // Compte banni par la modération : plus aucune création possible
    function notBanned() {
      let profile = /databases/$(database)/documents/users/$(me());
      return !exists(profile) || get(profile).data.get('banned', false) != true;
    }

    function canWrite() { return signedIn() && notBanned(); }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function pairOf(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    // Liste [uidA, uidB] triée, dont l'id de paire est pairId
    function isPairList(list, pairId) {
      return list is list && list.size() == 2 && list[0] < list[1]
        && pairId == list[0] + '_' + list[1];
    }

    // Les deux étudiants sont binômes : la demande (id = paire) est acceptée
    function areBuddies(pairId) {
      let req = /databases/$(database)/documents/requests/$(pairId);
      return exists(req) && get(req).data.status == 'accepted';
    }

    // other a bloqué me (document blocks/<bloqueur>_<bloqué>)
    function blockedBy(other) {
      return exists(/databases/$(database)/documents/blocks/$(other + '_' + me()));
    }

    // ---------------------------------------------------------------- Profils
    match /users/{userId} {
      // Son propre profil, un profil visible, ou la modération
      allow read: if signedIn()
        && (me() == userId || resource.data.profile_visible == true || isAdmin());

      // On n'écrit que son propre profil ; l'email n'y est plus stocké (vie privée)
      // et on ne peut pas modifier soi-même le bannissement
      allow create: if signedIn() && me() == userId
        && !('email' in request.resource.data)
        && !('banned' in request.resource.data);
      allow update: if signedIn() && me() == userId
        && !('email' in request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned']);
      allow delete: if signedIn() && me() == userId;

      // Modération : bannir / masquer un profil
      allow update: if isAdmin() && onlyChanges(['banned', 'profile_visible']);

      // Données privées (préférences de notification, âge…) : propriétaire seulement
      match /private/{docId} {
        allow read, write: if signedIn() && me() == userId;
      }
    }

    // ------------------------------------------------- Demandes de binôme
    // id = paire de uids : une seule demande par paire (plus de demandes croisées)
    match /requests/{pairId} {
      allow read: if signedIn()
        && (me() == resource.data.from_uid || me() == resource.data.to_uid);

      allow create: if canWrite()
        && request.resource.data.from_uid == me()
        && request.resource.data.to_uid != me()
        && pairId == pairOf(me(), request.resource.data.to_uid)
        && isPairList(request.resource.data.participants, pairId)
        && request.resource.data.status == 'pending'
        && !blockedBy(request.resource.data.to_uid);

      // Seul le destinataire accepte, et seulement le statut
      allow update: if signedIn()
        && resource.data.to_uid == me()
        && onlyChanges(['status'])
        && request.resource.data.status == 'accepted';

      // Refus, annulation, retrait du binôme ou blocage : l'un ou l'autre
      allow delete: if signedIn()
        && (me() == resource.data.from_uid || me() == resource.data.to_uid);
    }

    // ---------------------------------------------------------------- Blocages
    // id = "<bloqueur>_<bloqué>"
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blocker == me();
      allow create: if signedIn()
        && request.resource.data.blocker == me()
        && blockId == me() + '_' + request.resource.data.blocked
        && request.resource.data.blocked != me();
      allow delete: if signedIn() && resource.data.blocker == me();
    }

    // ---------------------------------------------------------------- Messages
    match /messages/{messageId} {
      allow read: if signedIn()
        && (me() in resource.data.participants
            || me() in resource.data.get('unreadBy', []));

      // Uniquement entre binômes (demande acceptée)
      allow create: if canWrite()
        && request.resource.data.senderUid == me()
        && me() in request.resource.data.participants
        && isPairList(request.resource.data.participants, request.resource.data.chatId)
        && areBuddies(request.resource.data.chatId)
        && request.resource.data.get('unreadBy', []).toSet()
             .difference(request.resource.data.participants.toSet().difference([me()].toSet()))
             .size() == 0
        && request.resource.data.get('text', '').size() <= 4000;

      // L'auteur modifie son texte
      allow update: if signedIn()
        && resource.data.senderUid == me()
        && onlyChanges(['text', 'isEdited'])
        && request.resource.data.text.size() <= 4000;

      // Le destinataire marque comme lu : il ne peut que se retirer de unreadBy
      allow update: if signedIn()
        && me() in resource.data.participants
        && onlyChanges(['unreadBy'])
        && request.resource.data.unreadBy == resource.data.unreadBy.removeAll([me()]);

      allow delete: if signedIn() && resource.data.senderUid == me();
    }

    // -------------------------------------------------------- Sessions d'étude
    match /sessions/{sessionId} {
      allow read: if signedIn() && me() in resource.data.participants;

      allow create: if canWrite()
        && request.resource.data.organizer_uid == me()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && me() in request.resource.data.participants
        && areBuddies(pairOf(request.resource.data.participants[0], request.resource.data.participants[1]))
        && request.resource.data.status == 'planned';

      // Terminer ou annuler : l'un ou l'autre participant, statut uniquement
      allow update: if signedIn()
        && me() in resource.data.participants
        && onlyChanges(['status'])
        && request.resource.data.status in ['completed', 'cancelled'];

      allow delete: if false;
    }

    // ---------------------------------------------------- Avis après session
    // id = "<sessionId>_<uid de l'auteur>" : un avis par personne et par session
    match /feedback/{feedbackId} {
      allow create: if canWrite()
        && request.resource.data.from_uid == me()
        && feedbackId == request.resource.data.sessionId + '_' + me()
        && me() in get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.participants
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------- Tableaux blancs
    // id = paire de uids. Les traits sont des documents de la sous-collection strokes.
    match /whiteboards/{boardId} {
      function isBoardMember() {
        return signedIn() && me() in boardId.split('_');
      }

      // resource == null : tableau pas encore créé (le premier onSnapshot doit pouvoir écouter)
      allow read: if isBoardMember();

      allow create: if isBoardMember() && notBanned()
        && isPairList(request.resource.data.participants, boardId)
        && areBuddies(boardId);
      allow update: if isBoardMember() && notBanned()
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /strokes/{strokeId} {
        allow read: if isBoardMember();
        allow create: if isBoardMember() && notBanned()
          && request.resource.data.uid == me()
          && areBuddies(boardId)
          && request.resource.data.get('points', []).size() <= 6000;
        // Défaire (ses propres traits) et "Tout effacer" (les deux membres)
        allow delete: if isBoardMember();
        allow update: if false;
      }
    }

    // ------------------------------------------------------------ Signalements
    match /reports/{reportId} {
      allow create: if canWrite()
        && request.resource.data.reporter_uid == me()
        && request.resource.data.reported_uid != me()
        && request.resource.data.status == 'pending';
      // Modération
      allow read: if isAdmin();
      allow update: if isAdmin() && onlyChanges(['status', 'handledAt', 'handledBy']);
      allow delete: if false;
    }

    // ------------------------------------------------------------- Modération
    // Les comptes administrateurs se créent à la main dans la console (admins/<uid>)
    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false;
    }

    // -------------------------------------------- Compteur public de l'accueil
    // Maintenu par la Cloud Function onProfileWrite (functions/) : lecture seule ici
    match /stats/public {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------- Tout le reste : fermé par défaut
    // (dont "mail" : file d'envoi d'e-mails, écrite uniquement par les Cloud Functions)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
