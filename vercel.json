{
  "rewrites": [
    {
      "source": "/About",
      "destination": "/About/index.html"
    },
    {
      "source": "/Legal",
      "destination": "/Legal/index.html"
    },
    {
      "source": "/Privacy",
      "destination": "/Privacy/index.html"
    },
    {
      "source": "/Etablissements",
      "destination": "/Etablissements/index.html"
    },
    {
      "source": "/((?!sitemap.xml|robots.txt|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
