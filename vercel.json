{
  "rewrites": [
    {
      "source": "/About",
      "destination": "/About/index.html"
    },
    {
      "source": "/Legal",
      "destination": "/Legal/index.html"
    },
    {
      "source": "/Privacy",
      "destination": "/Privacy/index.html"
    },
    {
      "source": "/Etablissements",
      "destination": "/Etablissements/index.html"
    },
    {
      "source": "/reviser",
      "destination": "/reviser/index.html"
    },
    {
      "source": "/reviser/:slug",
      "destination": "/reviser/:slug/index.html"
    },
    {
      "source": "/((?!sitemap.xml|robots.txt|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
